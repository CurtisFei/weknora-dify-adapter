# Existing WeKnora deployment. Both forms are accepted:
#   http://weknora:8080
#   http://weknora:8080/api/v1
WEKNORA_BASE_URL=http://weknora:8080

# Use a WeKnora key with only the `retrieve` capability and an explicit KB allowlist.
WEKNORA_API_KEY=replace-with-weknora-retrieve-key

# A separate random secret configured in Dify as the External Knowledge API key.
DIFY_ADAPTER_API_KEY=replace-with-a-long-random-adapter-key

WEKNORA_TIMEOUT_SECONDS=15
LOG_LEVEL=INFO
PORT=8000

